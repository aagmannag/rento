generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OwnerApprovalStatus {
  Pending
  Approved
  Rejected
  Suspended
}

enum VehicleStatus {
  Active
  Inactive
}

enum BookingStatus {
  Upcoming
  Completed
  Cancelled
}

enum PaymentStatus {
  Pending
  Submitted
  Verified
  Rejected
  /// A Pending booking whose payment hold window (see @rento/db's PENDING_HOLD_MINUTES)
  /// elapsed with no UTR ever submitted. Terminal, like Rejected, except there is no
  /// resubmission path — the hold is gone and the unit may already belong to someone
  /// else, so the customer must start a fresh booking instead.
  Expired
}

/// Owned by portalAdmin. The Rento platform's own admin accounts.
model AdminUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("admin_users")
}

/// Owned by portalPartner (shop owners sign up there); read/moderated by portalAdmin.
model ShopOwner {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerName       String              @map("owner_name")
  shopName        String              @map("shop_name")
  email           String              @unique
  passwordHash    String              @map("password_hash")
  phone           String
  city            String
  address         String
  pincode         String?
  latitude        Float?
  longitude       Float?
  status          OwnerApprovalStatus @default(Pending)
  rejectionReason String?             @map("rejection_reason")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  // Cached aggregate of PartnerRating rows (rentoCustomer's customers rating this shop
  // after a Completed+Verified booking) — incremented transactionally alongside each
  // new PartnerRating insert rather than computed live on every vehicle-listing read,
  // since that read happens on every homepage visit. ratingSum/ratingCount rather than
  // a running float average, so the average can always be recomputed exactly
  // (ratingSum / ratingCount) without float drift across many increments.
  // Display rule (see @rento/db's computeDisplayRating): below 5 real ratings, every
  // vehicle from this shop shows a static seed (4.5, matching the value hardcoded here
  // before this feature existed) instead of the real average, so a brand-new shop
  // doesn't look empty/unrated.
  ratingSum   Int @default(0) @map("rating_sum")
  ratingCount Int @default(0) @map("rating_count")

  vehicles Vehicle[]
  bookings Booking[]

  // Every customer-facing vehicle listing query joins through this filter
  // (WHERE o.status = 'Approved') — see @rento/db's listActivePartnerVehiclesWithAvailability.
  @@index([status])
  @@map("shop_owners")
}

/// Owned by portalPartner; read by rentoCustomer (customer-facing listings) and portalAdmin (moderation).
model Vehicle {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId         String        @map("owner_id") @db.Uuid
  owner           ShopOwner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category        String
  name            String
  brand           String
  engineLabel     String        @default("") @map("engine_label")
  photoUrl        String?       @map("photo_url")
  photoUrls       String[]      @default([]) @map("photo_urls")
  pricePerDay     Int           @map("price_per_day")
  pricePerHour    Int           @map("price_per_hour")
  securityDeposit Int           @map("security_deposit")
  stock           Int           @default(1)
  fuel            String        @default("Petrol")
  transmission    String        @default("Manual")
  seats           Int           @default(2)
  mileage         String        @default("")
  features        String[]      @default([])
  description     String?
  city            String
  status          VehicleStatus @default(Active)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  bookings Booking[]

  // Postgres does not automatically index foreign key columns — every join/filter on
  // owner_id (getVehiclesForOwner, moderation, the listing join) would otherwise be a
  // sequential scan once the table grows past a trivial size.
  @@index([ownerId])
  // Every customer-facing listing query filters WHERE status = 'Active'.
  @@index([status])
  @@map("vehicles")
}

/// Owned by portalPartner (shop owner's own booking ledger); mirrored into from
/// rentoCustomer when a customer books a partner-listed vehicle (best-effort, see
/// CustomerBooking.partnerBookingId); read by portalAdmin for platform stats and payment sync.
model Booking {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId        String        @map("owner_id") @db.Uuid
  owner          ShopOwner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  vehicleId      String        @map("vehicle_id") @db.Uuid
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  customerName   String        @map("customer_name")
  customerPhone  String        @map("customer_phone")
  // The rentoCustomer User.id who made this booking, set at creation time (see
  // rentoCustomer's createPartnerBooking). Deliberately NOT a Prisma relation — same
  // cross-app loosely-coupled reasoning as CustomerBooking.partnerBookingId below: this
  // points into a different app's table, and it must never block or cascade against
  // this app's own booking record. Nullable because bookings created before this
  // column existed have no value here; CustomerRating submission falls back to a
  // phone-number lookup against users.phone for those rows (see portalPartner's
  // submitCustomerRating), since customerPhone was always populated from the
  // authenticated user's own phone at booking time.
  userId         String?       @map("user_id") @db.Uuid
  pickupDateTime DateTime      @map("pickup_datetime") @db.Timestamptz(6)
  returnDateTime DateTime      @map("return_datetime") @db.Timestamptz(6)
  quantity       Int           @default(1)
  totalAmount    Int           @default(0) @map("total_amount")
  status         BookingStatus @default(Upcoming)
  paymentStatus  PaymentStatus @default(Pending) @map("payment_status")
  utrNumber      String?       @map("utr_number")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  customerRating CustomerRating?

  // Matches the exact WHERE clause of the booked-quantity aggregate (@rento/db's
  // bookedQuantity/listActivePartnerVehiclesWithAvailability) — the single hottest
  // query in the app, run on every vehicle-availability check and booking attempt.
  @@index([vehicleId, status, paymentStatus])
  // Postgres does not automatically index foreign key columns — getBookingsForOwner
  // and platform-stats aggregates filter/join on owner_id.
  @@index([ownerId])
  @@map("bookings")
}

/// Owned by rentoCustomer. Customer accounts (phone-based login).
model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone     String   @unique
  name      String   @default("Rento User")
  gender    String?
  city      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Cached aggregate of CustomerRating rows (shop owners rating this customer after a
  // Completed+Verified booking) — same ratingSum/ratingCount-over-cached-average
  // pattern as ShopOwner above, incremented transactionally alongside each new
  // CustomerRating insert. Shown on the customer's own rentoCustomer profile. Unlike
  // ShopOwner/the platform rating, there is no static seed/threshold here: a customer
  // with zero ratings simply shows "not yet rated" rather than a fabricated number —
  // this is a personal stat, not a public trust signal that needs to avoid looking empty.
  ratingSum   Int @default(0) @map("rating_sum")
  ratingCount Int @default(0) @map("rating_count")

  bookings CustomerBooking[]

  @@map("users")
}

/// Owned by rentoCustomer — the source of truth for a customer's own booking history and
/// manual UPI payment verification. `vehicleId` is a free-text id (may reference a
/// portalPartner vehicle, prefixed "partner-", or another listing source), not an FK.
/// `partnerBookingId` is deliberately NOT a Prisma relation to Booking: it's a
/// best-effort, loosely-coupled pointer into a different app's table, and sync failures
/// there must never block or cascade against a customer's own booking record.
model CustomerBooking {
  id                   String        @id
  userId               String        @map("user_id") @db.Uuid
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId            String        @map("vehicle_id")
  vehicleName          String        @map("vehicle_name")
  vehicleImage         String?       @map("vehicle_image")
  vehiclePhoto         String?       @map("vehicle_photo")
  city                 String
  category             String
  shopName             String        @map("shop_name")
  shopAddress          String        @map("shop_address")
  /// Frozen at booking time (same reasoning as shopName/shopAddress below) rather than
  /// looked up live from ShopOwner.phone — so a customer's own booking record keeps
  /// showing the number the shop actually had at the time they booked, even if the
  /// owner later changes it. Nullable with no backfill: only ever populated going
  /// forward, so every booking made before this column existed correctly reads as "not
  /// available" rather than a fabricated or misleading number.
  shopPhone            String?       @map("shop_phone")
  shopLatitude         Float?        @map("shop_latitude")
  shopLongitude        Float?        @map("shop_longitude")
  rentalMode           String        @map("rental_mode")
  pickupDateTime       DateTime      @map("pickup_datetime") @db.Timestamptz(6)
  returnDateTime       DateTime      @map("return_datetime") @db.Timestamptz(6)
  days                 Int           @default(0)
  hours                Int           @default(0)
  quantity             Int           @default(1)
  pricePerDay          Int           @map("price_per_day")
  pricePerHour         Int           @map("price_per_hour")
  rentalCost           Int           @map("rental_cost")
  securityDeposit      Int           @map("security_deposit")
  totalPayableOnline   Int           @map("total_payable_online")
  totalPayableAtShop   Int           @map("total_payable_at_shop")
  status               BookingStatus @default(Upcoming)
  paymentStatus        PaymentStatus @default(Pending) @map("payment_status")
  utrNumber            String?       @map("utr_number")
  paymentScreenshotUrl String?       @map("payment_screenshot_url")
  paymentNote          String?       @map("payment_note")
  partnerBookingId     String?       @map("partner_booking_id")
  paymentSubmittedAt   DateTime?     @map("payment_submitted_at") @db.Timestamptz(6)
  paymentVerifiedAt    DateTime?     @map("payment_verified_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  // Cancellation bookkeeping. All four are set together, and only ever on the
  // transition into Cancelled — null on every booking that was never cancelled.
  // The refund a cancellation earns depends on *when* it happened relative to pickup
  // (see rentoCustomer's lib/cancellationPolicy.ts), so the quote is frozen here at
  // cancel time rather than recomputed later, when "now" no longer means anything.
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  /// "customer" (self-service cancel) or "shop" (the shop couldn't honour it) — the
  /// two are refunded under different rules, so who acted has to be recorded.
  cancelledBy          String?       @map("cancelled_by")
  /// Percent of totalPayableOnline owed back, per the tier in force at cancelledAt.
  refundPercent        Int?          @map("refund_percent")
  /// Rupees owed back — the rounded, clamped figure the customer was actually quoted.
  refundAmount         Int?          @map("refund_amount")

  partnerRating  PartnerRating?
  platformRating PlatformRating?

  // getBookingsForUser filters WHERE user_id = $1 ORDER BY created_at DESC — a
  // composite index serves both the equality filter (leftmost-prefix rule: any query
  // filtering on user_id alone, e.g. getBookingRowForUser's id+userId lookup, still
  // uses this index) and the sort, without a separate in-memory sort step as the table
  // grows. Not automatically indexed since user_id is a plain column here, not a
  // declared foreign key (see the model doc comment on why).
  @@index([userId, createdAt])
  // portalPartner's updateBookingStatus syncs back via WHERE partner_booking_id = $1 —
  // every booking status change an owner makes would otherwise scan this whole table.
  @@index([partnerBookingId])
  // listPendingPayments (portalAdmin) filters WHERE payment_status = 'Submitted'.
  @@index([paymentStatus])
  @@map("customer_bookings")
}

/// Owned by rentoCustomer. A customer's rating of the shop/partner for one completed
/// booking — submitted from the confirmation page once CustomerBooking.status is
/// Completed and paymentStatus is Verified. `customerBookingId` is a real FK (same-app,
/// unlike the cross-app pointers elsewhere) and is @unique so a booking can only ever
/// be rated once — that uniqueness is what makes "already rated" a DB guarantee instead
/// of app-level bookkeeping, and what makes a double-submit safely idempotent.
/// `ownerId` is deliberately NOT a relation: it points into portalPartner's ShopOwner
/// table, same cross-app reasoning as CustomerBooking.partnerBookingId. Submitting this
/// also transactionally increments ShopOwner.ratingSum/ratingCount (see rentoCustomer's
/// submitPartnerRating) — unlike the best-effort status mirrors elsewhere, this
/// increment happens in the SAME transaction as the insert, because the aggregate here
/// is load-bearing (it drives the static→dynamic shop-rating switch), not just a
/// cosmetic status copy that's fine to lose on a rare failure.
model PartnerRating {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerBookingId String   @unique @map("customer_booking_id")
  customerBooking   CustomerBooking @relation(fields: [customerBookingId], references: [id], onDelete: Cascade)
  userId            String   @map("user_id") @db.Uuid
  ownerId           String   @map("owner_id") @db.Uuid
  stars             Int
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Shop owners view their own received ratings (a fast-follow surface, not built yet)
  // filtered by owner_id — plain column, not a declared FK, so needs its own index.
  @@index([ownerId])
  // rentoCustomer's getBookingsForUser/getBookingForUser filter WHERE user_id = $1 (see
  // their doc comments — fetched by user_id directly, in parallel with the main booking
  // query, rather than only after learning which booking ids are eligible).
  @@index([userId])
  @@map("partner_ratings")
}

/// Owned by rentoCustomer. A customer's rating of the Rento platform overall for one
/// completed booking — same one-per-booking uniqueness/eligibility rules as
/// PartnerRating, submitted alongside it but entirely independent (a customer may rate
/// one without the other, submitted as two separate requests). No cached aggregate on
/// any model here: the platform-wide average is computed live over this table (see
/// @rento/db's computeDisplayRating usage in rentoCustomer's platform-rating route) —
/// this table is orders of magnitude smaller than bookings, so a live COUNT/AVG is
/// cheap and avoids maintaining a singleton counter row for no real benefit.
model PlatformRating {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerBookingId String   @unique @map("customer_booking_id")
  customerBooking   CustomerBooking @relation(fields: [customerBookingId], references: [id], onDelete: Cascade)
  userId            String   @map("user_id") @db.Uuid
  stars             Int
  comment           String?
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // rentoCustomer's getBookingsForUser/getBookingForUser filter WHERE user_id = $1 —
  // see PartnerRating's identical index for why.
  @@index([userId])
  @@map("platform_ratings")
}

/// Owned by portalPartner. A shop owner's rating of the customer for one completed
/// booking — the mirror of PartnerRating, submitted from the owner's bookings page.
/// `partnerBookingId` is a real FK (same-app) and @unique for the same
/// one-rating-per-booking guarantee. `userId` is deliberately NOT a relation: it points
/// into rentoCustomer's User table (see portalPartner's submitCustomerRating for how
/// it's resolved — Booking.userId when present, else a phone-number lookup for
/// bookings created before that column existed). Submitting this transactionally
/// increments User.ratingSum/ratingCount, same "load-bearing, not cosmetic" reasoning
/// as PartnerRating's ShopOwner increment above.
model CustomerRating {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partnerBookingId String   @unique @map("partner_booking_id")
  booking          Booking  @relation(fields: [partnerBookingId], references: [id], onDelete: Cascade)
  ownerId          String   @map("owner_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  stars            Int
  comment          String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // rentoCustomer's profile page reads a customer's own received ratings filtered by
  // user_id — plain column, not a declared FK, so needs its own index.
  @@index([userId])
  // portalPartner's getBookingsForOwner filters WHERE owner_id = $1, fetched in
  // parallel with the main bookings query rather than only after learning which
  // booking ids are eligible (same fix, same reasoning as rentoCustomer's
  // getBookingsForUser — see its doc comment).
  @@index([ownerId])
  @@map("customer_ratings")
}

/// Owned by rentoCustomer. "Contact us" form submissions.
model ContactMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  contact   String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("contact_messages")
}
