# Prisma CLI env (used by `prisma generate`/`migrate`/`studio` run from this package).
# All 3 apps (portalAdmin, portalPartner, rentoCustomer) point at this SAME database —
# copy the values from any one of their .env.local files, they're identical.

# Pooled connection (Neon's pgbouncer, "-pooler" host) — used for normal query traffic.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Direct, non-pooled connection (no "-pooler") — required by `prisma migrate` since
# migrations need a session-mode connection that pgbouncer's transaction mode can't give.
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
