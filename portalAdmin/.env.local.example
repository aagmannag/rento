# PostgreSQL connection string. Points at the SAME database as portalPartner and
# rentoCustomer — this app reads/updates shop_owners and vehicles (approval workflow +
# moderation), owns one additional table (admin_users), and reads/updates
# rentoCustomer's customer_bookings for manual UPI payment verification. All three apps
# and the shared @rento/db package (packages/db) point at this one database.
#
# Use Neon's POOLED connection string here (the "-pooler" host) — this is what the app
# uses for normal query traffic at runtime. Local Docker/Postgres: any local connection
# string works as-is, no pooler involved.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Schema migrations (packages/db) are run separately from this app, via
# `npm run db:migrate` at the repo root — see packages/db/.env.example for the
# DATABASE_URL (pooled) + DIRECT_URL (non-pooled, required by `prisma migrate` against
# Neon's pgbouncer) it needs. Not read by this app.

# Secret used to sign the admin session JWT. Keep distinct from the other two apps'
# JWT_SECRET so sessions can never be replayed across apps.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=NiscilYjWKpk3rQdrl5ca5U7W2hTINZ8lg1sBSZEGWu

# Origin of the portalForShopOwner app, used to resolve its /uploads/... vehicle photo
# paths into absolute URLs. Defaults to http://localhost:3001 if unset. Only matters for
# photos stored on local disk (no Cloudinary configured there) — a Cloudinary-hosted
# photo is already a full https:// URL and needs no resolving, so once that app has
# CLOUDINARY_* set, this var only affects any older local-disk photos still on record.
PARTNER_PORTAL_ORIGIN=http://localhost:3001

# Origin of the rentoCustomer app, used to resolve its /uploads/payments/... payment
# screenshot paths into absolute URLs. Defaults to http://localhost:3000 if unset. Same
# Cloudinary caveat as above — only matters for screenshots stored on local disk.
RENTO_CUSTOMER_ORIGIN=http://localhost:3000

# Optional shared cache (see packages/db/src/cache.ts) — speeds up vehicle-moderation
# reads by serving them from Redis instead of Neon when possible. Safe to leave unset.
# MUST be the same Upstash database as rentoCustomer/portalPartner/packages/db if set,
# so approving/rejecting a shop here invalidates the public listing rentoCustomer shows
# immediately instead of only after this cache's own TTL — see packages/db/.env.example.
UPSTASH_REDIS_REST_URL=https://example-12345.upstash.io
UPSTASH_REDIS_REST_TOKEN=<paste the REST token here>
