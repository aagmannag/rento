# PostgreSQL connection string. Can point at the SAME database as rentoCustomer —
# this app only creates/uses its own tables (shop_owners, vehicles, bookings) and
# never touches the `users` table, so there's no collision.
DATABASE_URL=postgresql://user:password@localhost:5432/rento

# Secret used to sign the owner session JWT. Keep this different from rentoCustomer's
# JWT_SECRET so a customer session cookie can never be replayed here (and vice versa).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=NiscilYjWKpk3rQdrl5ca5U7W2hTINZ8lg1sBSZEGWu

# Cloudinary (vehicle photo storage). Optional in local dev — if unset, uploaded photos
# are written to public/uploads/vehicles on local disk instead. REQUIRED for any deploy
# target with an ephemeral filesystem (Vercel, most serverless hosts, containers without
# a persistent volume), since a locally written file wouldn't survive past that request.
# Get these from your Cloudinary dashboard (cloudinary.com) → Account Details. The API
# secret is server-only — never expose it with a NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=djkss2ach
CLOUDINARY_API_KEY=688358929311895
CLOUDINARY_API_SECRET=ye99z3gapZDa8Vzmw8-hSSr027Q
