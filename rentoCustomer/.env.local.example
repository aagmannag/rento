# Firebase client config (safe to expose to the browser — these are public identifiers,
# not secrets; Firebase security relies on server-side rules/token verification, not on
# hiding these values).
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCMWfOg9lqpKgWheF7unkqPEZLO7-N--7c
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rento-aaa34.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rento-aaa34
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rento-aaa34.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=423547088829
NEXT_PUBLIC_FIREBASE_APP_ID=1:423547088829:web:c08bb5f18cf931544b2cd4

# Firebase Admin SDK (SERVER-SIDE SECRET — do not expose with NEXT_PUBLIC_ prefix).
# Get these from Firebase Console > Project Settings > Service Accounts >
# "Generate new private key" (downloads a JSON file with these three fields).
FIREBASE_ADMIN_PROJECT_ID=rento-aaa34
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-fbsvc@rento-aaa34.iam.gserviceaccount.com
# Paste the private_key value from the JSON file into .env.local. Keep the \n escape
# sequences literal (as a single-line string) — the code un-escapes them at runtime.
FIREBASE_ADMIN_PRIVATE_KEY="<paste the service account private_key here>"

# PostgreSQL connection string. Points at the SAME database as portalAdmin and
# portalPartner — this app owns users/customer_bookings/contact_messages, and reads
# portalPartner's vehicles/shop_owners for partner listings. All three apps and the
# shared @rento/db package (packages/db) point at this one database.
#
# Use Neon's POOLED connection string here (the "-pooler" host) — this is what the app
# uses for normal query traffic at runtime. Local Docker/Postgres: any local connection
# string works as-is, no pooler involved.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Schema migrations (packages/db) are run separately from this app, via
# `npm run db:migrate` at the repo root — see packages/db/.env.example for the
# DATABASE_URL (pooled) + DIRECT_URL (non-pooled, required by `prisma migrate` against
# Neon's pgbouncer) it needs. Not read by this app.

# Origin of the portalForShopOwner app, used to resolve its /uploads/... vehicle photo
# paths into absolute URLs. Defaults to http://localhost:3001 if unset.
PARTNER_PORTAL_ORIGIN=http://localhost:3001

# Secret used to sign our own session JWT (separate from Firebase's tokens).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=NiscilYjWKpk3rQdrl5ca5U7W2hTINZ8lg1sBSZEGWu

# Cloudinary (payment screenshot storage). Optional in local dev — if unset, uploaded
# screenshots are written to public/uploads/payments on local disk instead. REQUIRED for
# any deploy target with an ephemeral filesystem (Vercel, most serverless hosts,
# containers without a persistent volume), since a locally written file wouldn't survive
# past that request. Can reuse the same Cloudinary account/credentials as
# portalForShopOwner — uploads from each app go into separate folders regardless.
# Get these from your Cloudinary dashboard (cloudinary.com) → Account Details. The API
# secret is server-only — never expose it with a NEXT_PUBLIC_ prefix.
CLOUDINARY_CLOUD_NAME=djkss2ach
CLOUDINARY_API_KEY=688358929311895
CLOUDINARY_API_SECRET=ye99z3gapZDa8Vzmw8-hSSr027Q